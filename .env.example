# Copy to .env and edit. Every line here is optional except where the comment
# says otherwise — `docker compose up` runs the proxy alone with no .env at all.

# ---- the proxy ----------------------------------------------------------

# Run as whoever owns the CA private key on the host. It is mode 600 and stays
# that way, so the container has to be the same uid to read it.
MACH5_UID=1000
MACH5_GID=1000

# info is a reasonable default; debug gives handshake detail.
RUST_LOG=info

# WHERE THE PROXY ITSELF RESOLVES. This must be a resolver that gives real
# answers — pi-hole, your router, a public resolver. It must NOT be the wildcard
# resolver below: mach5 would resolve every origin back to itself and fetch
# itself in a loop.
MACH5_UPSTREAM_DNS=1.1.1.1


# ---- the wildcard resolver (optional) -----------------------------------
#
# Only needed if you want compose to run one. Start it with:
#
#   docker compose --profile dns up
#
# Skip all of this if you already have something answering every name with the
# proxy's address.

# REQUIRED for the resolver: the address every name will resolve to, which is
# where mach5 is listening. Usually this host's LAN address.
MACH5_PROXY_IP=192.168.1.10

# WHERE THE RESOLVER LISTENS. Port 53 is not shareable, so this matters only if
# something else on this machine already answers DNS — pi-hole, usually.
#
#   pi-hole on another machine     leave this unset; it listens everywhere
#   pi-hole here, clients via VPN  set it to your WireGuard address, which
#                                  already exists and is where clients arrive
#   pi-hole here, clients on LAN   set it to a second LAN address, which you
#                                  do have to create and persist yourself
#
# `ip addr show wg0` for the middle case.
#MACH5_DNS_BIND=10.7.0.1
